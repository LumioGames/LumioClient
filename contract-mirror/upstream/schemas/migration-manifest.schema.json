{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.games/schema/migration-manifest.schema.json",
  "type": "object",
  "required": ["migrationId", "sourceReleaseId", "targetReleaseId", "sourceSchemaEpoch", "targetSchemaEpoch", "staging", "activation", "scopeActivation", "nodes"],
  "properties": {
    "migrationId": { "$ref": "common.schema.json#/$defs/id" },
    "sourceReleaseId": { "$ref": "common.schema.json#/$defs/releaseId" },
    "targetReleaseId": { "$ref": "common.schema.json#/$defs/releaseId" },
    "sourceSchemaEpoch": { "$ref": "common.schema.json#/$defs/revision" },
    "targetSchemaEpoch": { "$ref": "common.schema.json#/$defs/revision" },
    "staging": { "type": "string", "enum": ["ImmutableSourceCopy", "ObjectStoreVersion", "DatabaseShadow"] },
    "activation": { "type": "string", "enum": ["AtomicPointer", "TransactionalRename"] },
    "scopeActivation": { "$ref": "gameplay-scope-activation.schema.json" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nodeId", "owner", "dependsOn", "inputSchema", "outputSchema", "inputHash", "outputHash", "toolVersion", "idempotent"],
        "properties": {
          "nodeId": { "$ref": "common.schema.json#/$defs/id" },
          "owner": { "type": "string", "enum": ["Game", "VoxelEngine", "Runtime", "Tooling"] },
          "dependsOn": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
          "inputSchema": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,127}$" },
          "outputSchema": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,127}$" },
          "inputHash": { "$ref": "common.schema.json#/$defs/hash256" },
          "outputHash": { "$ref": "common.schema.json#/$defs/hash256" },
          "toolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "idempotent": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
