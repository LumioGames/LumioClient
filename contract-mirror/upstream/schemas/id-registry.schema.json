{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.games/schema/id-registry.schema.json",
  "type": "object",
  "required": ["registryVersion", "baselineId", "namespaces"],
  "properties": {
    "registryVersion": { "type": "integer", "const": 1 },
    "baselineId": { "type": "string", "const": "LGE-V1.4-2026-08-27" },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["namespace", "owner", "values"],
        "properties": {
          "namespace": { "$ref": "common.schema.json#/$defs/id" },
          "owner": { "type": "string", "enum": ["Architecture", "NativeCore", "VoxelEngine", "CoreEngine", "GameRuntime", "Server", "Client", "Game"] },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "numeric", "status"],
              "properties": {
                "id": { "$ref": "common.schema.json#/$defs/id" },
                "numeric": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
                "status": { "type": "string", "enum": ["Active", "Reserved", "Deprecated"] },
                "since": { "type": "string", "pattern": "^V[0-9]+$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
