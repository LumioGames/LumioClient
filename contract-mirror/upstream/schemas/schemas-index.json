{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.games/schema/schemas-index.json",
  "type": "object",
  "required": ["schemaSetVersion", "baselineId", "schemas"],
  "properties": {
    "schemaSetVersion": { "type": "integer", "const": 1 },
    "baselineId": { "type": "string", "const": "LGE-V1.4-2026-08-27" },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file", "priority", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "file": { "type": "string", "pattern": "^[a-z0-9-]+\\.schema\\.json$" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "owner": { "type": "string", "enum": ["Architecture", "NativeCore", "VoxelEngine", "CoreEngine", "GameRuntime", "Server", "Client", "Game"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
