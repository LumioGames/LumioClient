{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.games/schema/artifact-index.schema.json",
  "type": "object",
  "required": ["indexVersion", "targetProfileId", "entries", "artifactSetDigest"],
  "properties": {
    "indexVersion": { "type": "integer", "minimum": 1 },
    "targetProfileId": { "$ref": "common.schema.json#/$defs/id" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "artifactSetDigest": { "$ref": "common.schema.json#/$defs/hash256" }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["path", "kind", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
        "kind": { "type": "string", "enum": ["NativeLibrary", "DebugSymbols", "Header", "ManagedBinding", "Metadata", "License", "Sbom", "Provenance"] },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "common.schema.json#/$defs/hash256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
